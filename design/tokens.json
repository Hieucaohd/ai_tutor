{
  "version": "1.0",
  "unit": "CSS px unless noted",
  "color": {
    "navy": "#183C48", "teal": "#226D78", "tealHover": "#1B5963", "tealActive": "#164A53",
    "textMuted": "#526971", "bg": "#F6F9F9", "surface": "#FFFFFF", "border": "#D5E2E3",
    "controlBorder": "#647D83", "focus": "#183C48", "focusInverse": "#8DD5D0",
    "heroStart": "#EEF8F7", "heroEnd": "#F8FAFB", "stepsBg": "#EAF2F2", "trustBg": "#E9F3F1",
    "aiBubble": "#EDF5F4", "studentBubble": "#E8EEF6", "footerText": "#D0E1E2", "accentLight": "#8DD5D0"
  },
  "font": {
    "family": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "h1": {"size": "clamp(32px, 3.5vw, 48px)", "lineHeight": 1.2, "weight": 800, "letterSpacing": "-0.03em"},
    "h2": {"size": "clamp(26px, 2.5vw, 34px)", "lineHeight": 1.3, "weight": 750},
    "h3": {"size": 18, "lineHeight": 1.45, "weight": 700},
    "lead": {"size": 17, "lineHeight": 1.8},
    "body": {"size": 16, "lineHeight": 1.75},
    "nav": {"size": 15, "lineHeight": 1.5, "weight": 650},
    "small": {"size": 13, "lineHeight": 1.6},
    "eyebrow": {"size": 12, "lineHeight": 1.6, "weight": 800, "letterSpacing": "0.1em"}
  },
  "layout": {"containerMax": 1160, "gutterMobile": 20, "gutterTablet": 32, "desktopMin": 1024, "tabletMin": 768, "smallGridMin": 480},
  "spacing": [4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 64, 72],
  "radius": {"badge": 8, "button": 12, "card": 16, "panel": 20},
  "shadow": {"panel": "0 16px 38px rgb(27 91 104 / 8%)"},
  "control": {"minHeight": 44, "focusWidth": 3, "focusOffset": 3},
  "motion": {"smoothScroll": "only when prefers-reduced-motion is no-preference", "animation": "none"}
}
